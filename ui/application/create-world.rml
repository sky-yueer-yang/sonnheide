<rml><head><title>SONNHEIDE</title><link type="text/rcss" href="create-world.rcss"/></head><body>
<div id="earth-title-row"><h1 id="earth-heading">创建世界</h1><p id="earth-facts"></p><p id="earth-area"></p></div>
<div id="earth-name-group"><label id="earth-text-name">世界名称</label><input id="earth-world-name" type="text" value="Sonnheide" maxlength="96"/></div>
<p id="earth-status"></p>
<div id="earth-sources-panel"><p id="earth-source-position"></p><p id="earth-text-sourcefacts"></p><p id="earth-text-sourceart"></p></div>
<nav id="earth-toolbar">
<button id="earth-action-back"><span id="earth-text-back">返回</span></button>
<button id="earth-action-select"><span id="earth-text-select">选择范围</span></button>
<button id="earth-action-scale">地图比例</button>
<button id="earth-action-preview"><span id="earth-text-preview">预览地表</span></button>
<button id="earth-action-atlas"><span id="earth-text-atlas">调整选区</span></button>
<button id="earth-action-light"><span id="earth-text-light">明亮环境</span></button>
<button id="earth-action-dark"><span id="earth-text-dark">黑暗环境</span></button>
<button id="earth-action-create"><span id="earth-text-create">创建世界</span></button>
<button id="earth-action-view">总览</button>
<button id="earth-action-sources"><span id="earth-text-sources">来源</span></button>
<button id="earth-action-cancel"><span id="earth-text-cancel">取消</span></button>
</nav></body></rml>
