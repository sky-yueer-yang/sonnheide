body { width: 100%; height: 100%; margin: 0; font-family: Noto Serif CJK SC; font-size: 18dp; color: #fff6df; }
div, nav, h1, p { display: block; }
h1, p { margin: 0; font-weight: normal; }
#earth-title-row { position: absolute; left: 32dp; top: 24dp; padding: 18dp 24dp; background-color: #080e14ce; }
h1 { font-size: 26dp; line-height: 36dp; }
p { font-size: 16dp; line-height: 26dp; color: #d3d6cb; }
#earth-name-group { position: absolute; left: 56dp; top: 176dp; background-color: #080e14df; padding: 18dp 24dp; }
label { display: block; font-size: 16dp; margin-bottom: 12dp; }
input { border-width: 0; background-color: #fff6df12; color: #fff6df; font-size: 20dp; width: 240dp; padding: 10dp 12dp; }
#earth-status { position: absolute; left: 32dp; bottom: 132dp; max-width: 75%; padding: 18dp 24dp; background-color: #080e14eb; font-size: 18dp; line-height: 28dp; }
#earth-toolbar { position: absolute; left: 0; bottom: 0; width: 100%; min-height: 106dp; padding: 30dp 32dp; box-sizing: border-box; background-color: #080e14f5; }
button { display: inline-block; border-width: 0; background-color: transparent; color: #d4d3c6; margin: 0 24dp 8dp 0; padding: 10dp 0; font-size: 18dp; cursor: pointer; tab-index: auto; }
button:hover, button:focus, button.selected { color: #fff6df; font-weight: bold; }
button:disabled { color: #6b716e; cursor: arrow; }
#earth-action-create { color: #fff6df; }

#earth-sources-panel { position: absolute; right: 32dp; top: 24dp; width: 380dp; max-width: 80%; max-height: 35%; overflow: auto; padding: 24dp; background-color: #080e14ed; }
#earth-sources-panel p { margin-bottom: 16dp; }
