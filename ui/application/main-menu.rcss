div, nav, section, h1, h2, h3, p { display: block; }
body { margin: 0; width: 100%; height: 100%; font-family: Noto Serif CJK SC; font-size: 18dp; color: #fff6df; }
button { border-width: 0; background-color: transparent; color: #fff6df; padding: 0; margin: 0; font-size: 18dp; cursor: pointer; tab-index: auto; }
button:hover, button:focus { color: #ffffff; font-weight: bold; }
button:disabled { color: #aaa493; cursor: arrow; }
h1, h2, h3, p { margin: 0; font-weight: normal; }
#menu-group { position: absolute; width: 300dp; top: 480dp; right: 7%; text-align: right; }
h1 { font-family: Cinzel; font-size: 18dp; line-height: 21.24dp; font-effect: glow(2px 3px #fff6df38); }
nav { margin-top: 12dp; }
nav button { display: block; width: 100%; height: 24dp; line-height: 21.24dp; text-align: right; font-effect: glow(2px 3px #fff6df38); }
#overlay { display: none; position: absolute; left: 0; top: 0; width: 100%; height: 100%; background-color: #080605bb; }
#dialog { position: absolute; top: 90dp; left: 320dp; width: 640dp; max-height: 85%; overflow-y: auto; background-color: #100e0bf8; padding: 38dp 40dp 26dp; box-sizing: border-box; }
h2 { font-size: 27dp; line-height: 1.4; margin-bottom: 22dp; color: #eee5d0; }
h3 { font-size: 18dp; margin-top: 18dp; margin-bottom: 7dp; color: #eee5d0; }
p { font-size: 16dp; line-height: 1.85; margin-bottom: 16dp; color: #c4b89f; }
.choices { margin-bottom: 8dp; }
.choices button { display: inline-block; margin-right: 22dp; padding: 6dp 0; font-size: 16dp; color: #a49780; }
.choices button:hover, .choices button:focus, .choices button.selected { color: #fff6df; font-weight: bold; }
.actions { text-align: right; margin-top: 24dp; }
.actions button { padding: 8dp 0 8dp 20dp; font-size: 16dp; }
#text-preferror { margin-top: 18dp; }

.tracked { margin-left: 0.18dp; }
