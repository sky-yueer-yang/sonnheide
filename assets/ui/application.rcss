/* Deep grey carved stone panels and controls share one original pixel material.
   State brightness changes the same stone; inputs remain recessed obsidian.
   Warm grey type has actual directional weight. Only the wordmark retains its contour. */
body, section, div, nav, h1, h2, h3, p, label { display: block; }
body { margin: 0; width: 100%; height: 100%; font-family: Sonn Arcade; font-size: 12dp; line-height: 18dp; font-weight: normal; color: #dedbd4; }
h1, h2, h3, p { margin: 0; font-weight: normal; }
h1 { font-size: 36dp; line-height: 52dp; }
h2 { font-size: 24dp; line-height: 36dp; color: #eeeae0; font-effect: pixel-bold(1px #eeeae0); }
h2.danger-heading { color: #eeeae0; }
p { margin: 6dp 0; line-height: 18dp; word-break: break-word; }
label { margin: 8dp 0 4dp; line-height: 18dp; color: #dedbd4; }
button, input, select, selectbox, option, scrollbarvertical sliderbar, scrollbarvertical slidertrack, scrollbarvertical sliderarrowdec, scrollbarvertical sliderarrowinc { border-width: 0; background-color: transparent; font-family: Sonn Arcade; }
button { display: inline-block; box-sizing: border-box; min-height: 48dp; max-width: 100%; padding: 6dp 12dp; margin: 0; font-size: 24dp; font-weight: normal; line-height: 28dp; color: #dedbd4; tab-index: auto; cursor: pointer; vertical-align: middle; decorator: physical-material(rock #bbbbbbff); }
button:hover, button:focus { decorator: physical-material(rock #ffffffff); color: #fffaf0; }
button.selected, button.primary { decorator: physical-material(rock #eeeeeeff); color: #fff8e8; }
button.selected:hover, button.selected:focus, button.primary:hover, button.primary:focus { decorator: physical-material(rock #ffffffff); color: #fffaf0; }
button:active { decorator: physical-material(rock #8c8c8cff); }
button:disabled { decorator: physical-material(rock #686868ff); color: #96948e; cursor: arrow; opacity: 0.6; }
button img { display: inline-block; width: 48dp; height: 48dp; margin-right: 8dp; vertical-align: middle; }
input, select { display: block; width: 100%; box-sizing: border-box; min-height: 44dp; padding: 6dp 10dp; font-size: 24dp; line-height: 28dp; color: #dedbd4; tab-index: auto; decorator: physical-material(obsidian); }
input:focus, select:focus { decorator: physical-material(obsidian #ffffffff 4dp 2dp 3dp); }
input:disabled, select:disabled { color: #96948e; }
selectvalue { padding: 0; }
selectarrow { width: 16dp; height: 12dp; decorator: pixel-down(#ffffff); }
selectbox { padding: 6dp; decorator: physical-material(rock); }
option { display: block; min-height: 40dp; padding: 6dp 8dp; font-size: 24dp; color: #dedbd4; decorator: physical-material(rock #bbbbbbff); }
option:hover, option:checked { decorator: physical-material(rock #ffffffff); color: #fffaf0; }
.panel { decorator: physical-material(rock); }
.setting-block { padding: 0 4dp 4dp; margin-top: 6dp; }
.setting-block label:first-child { margin-top: 4dp; }
#main-screen, #creation-screen, #world-screen, #load-screen { position: absolute; left: 0; top: 0; width: 100%; height: 100%; }
#main-menu { decorator: physical-material(rock); position: absolute; box-sizing: border-box; padding: 16dp; text-align: center; overflow-y: auto; }
#home-wordmark { position: relative; height: 56dp; margin: 0 0 12dp; }
#main-title { position: absolute; top: 0; left: 0; width: 100%; margin: 0; font-size: 36dp; line-height: 52dp; }
#main-title, #main-title .title-sun, #main-title .title-sea, #main-title .title-sky { color: #d99100; }
#main-title { font-effect: pixel-outline(2px #ffffff), pixel-outline(1px #d99100); }
#main-title span { display: inline; }
#main-actions { display: block; }
.menu-cell { width: 100%; box-sizing: border-box; padding: 2dp 0; }
#main-menu button { display: block; width: 100%; min-height: 60dp; padding: 6dp 12dp; text-align: left; font-size: 24dp; line-height: 48dp; }
#main-menu button img { width: 48dp; height: 48dp; margin: 0 12dp 0 0; }
.topbar { position: absolute; left: 16dp; top: 12dp; right: 16dp; }
.topbar-row { display: flex; align-items: center; }
.topbar h2 { flex-grow: 1; flex-shrink: 1; min-width: 0; margin: 0 12dp; font-size: 24dp; }
.topbar button { flex-shrink: 0; }
.compact .topbar button span { display: none; }
.compact .topbar button img { margin-right: 0; }
.compact .topbar h2 { font-size: 12dp; font-effect: none; }
.quiet { color: #b5b3ad; }
#creation-controls { decorator: physical-material(rock); z-index: 2; position: absolute; box-sizing: border-box; padding: 16dp; overflow-y: auto; }
.input-pair { display: flex; width: 100%; }
.input-pair div { width: 50%; box-sizing: border-box; padding-right: 4dp; flex-shrink: 0; }
.input-pair div:last-child { padding-right: 0; padding-left: 4dp; }
.input-pair label { margin-top: 4dp; }
.size-presets { display: flex; flex-wrap: wrap; margin: 4dp 0; }
.size-presets button { width: 20%; flex-shrink: 0; min-height: 88dp; padding: 6dp 1dp; font-size: 12dp; line-height: 16dp; text-align: center; }
.size-presets button img { display: block; width: 48dp; height: 48dp; margin: 0 auto 4dp; }
.size-presets button span { display: block; word-break: break-word; }
.choices { margin: 4dp 0 6dp; }
.choices button { margin: 0 4dp 4dp 0; }
.actions { margin-top: 12dp; }
.actions button { margin: 0 4dp 4dp 0; }
.compact .actions button { display: block; width: 100%; margin: 0 0 6dp; }
.creation-actions { display: flex; }
.creation-actions button { display: inline-block; width: 50%; flex-shrink: 0; min-height: 60dp; padding: 6dp 6dp; font-size: 24dp; line-height: 48dp; text-align: center; margin: 0; }
.creation-actions button img { display: inline-block; width: 48dp; height: 48dp; margin: 0 8dp 0 0; }
.stacked-actions .creation-actions { display: block; }
.stacked-actions .creation-actions button { display: block; width: 100%; margin: 0 0 6dp; }
.preview-tray .creation-actions { margin: 0; }
.preview-tray .creation-actions button { padding: 6dp 6dp; margin: 0; }
.preview-tray #create { width: 100%; }
#create, #settings-close, #load-selected, #rename-commit { decorator: physical-material(rock #eeeeeeff); color: #fff8e8; }
#create:hover, #create:focus, #settings-close:hover, #settings-close:focus, #load-selected:hover, #load-selected:focus, #rename-commit:hover, #rename-commit:focus { decorator: physical-material(rock #ffffffff); color: #fffaf0; }
#create:disabled, #rename-commit:disabled, #load-selected:disabled { decorator: physical-material(rock #686868ff); color: #96948e; }
#creation-population { font-size: 12dp; line-height: 18dp; padding: 0 4dp; }
#creation-scale { font-size: 12dp; line-height: 18dp; margin: 4dp 0; color: #b5b3ad; }
#scene-viewport { position: absolute; background-color: transparent; }
#preview-caption { position: absolute; top: 76dp; margin: 0; font-size: 12dp; line-height: 18dp; padding: 8dp 12dp; decorator: physical-material(rock); }
#world-status { position: absolute; top: 12dp; left: 12dp; max-width: 85%; box-sizing: border-box; padding: 8dp; decorator: physical-material(rock); }
#world-status button { padding: 6dp 8dp; font-size: 24dp; decorator: physical-material(rock #bbbbbbff); }
#world-status button:hover, #world-status button:focus { decorator: physical-material(rock #ffffffff); }
#world-name { word-break: break-word; color: #eeeae0; font-size: 24dp; line-height: 36dp; font-effect: pixel-bold(1px #eeeae0); }
#world-time { display: inline-block; margin: 0 8dp; font-size: 12dp; color: #dedbd4; }
/* Broad, low category shoulders stand above a permanent two-row tool dock. */
#bottom-dock { position: absolute; bottom: 0; left: 0; width: 100%; box-sizing: border-box; }
#section-tabs { position: relative; z-index: 3; height: 42dp; padding: 0 8dp; box-sizing: border-box; }
#bottom-bar { display: flex; flex-wrap: nowrap; height: 42dp; box-sizing: border-box; padding: 0; margin: 0 auto; text-align: center; }
#bottom-bar button { height: 38dp; min-height: 38dp; flex-shrink: 0; padding: 4dp 4dp 6dp; margin: 4dp 0 0; font-size: 12dp; decorator: physical-tab(rock #bbbbbbff); }
#bottom-bar button.selected { height: 42dp; min-height: 42dp; margin-top: 0; padding-top: 8dp; decorator: physical-tab(rock #eeeeeeff); }
#bottom-bar button:hover, #bottom-bar button:focus { decorator: physical-tab(rock #ffffffff); }
#bottom-bar button.selected:hover, #bottom-bar button.selected:focus { decorator: physical-tab(rock #ffffffff); }
#bottom-bar img { display: block; width: 48dp; height: 28dp; margin: 0 auto; }
#bottom-bar-frame { position: relative; z-index: 1; width: 100%; box-sizing: border-box; padding: 12dp 8dp 8dp; decorator: physical-dock(rock); }
#toolbar-content { position: relative; height: 124dp; }
.toolbar { position: absolute; box-sizing: border-box; height: 124dp; }
.toolbar button { position: absolute; width: 60dp; min-width: 60dp; height: 60dp; min-height: 60dp; padding: 6dp; margin: 0; font-size: 12dp; text-align: center; }
.toolbar button img { display: block; width: 48dp; height: 48dp; margin: 0; }
#persistent-tools { left: 0; top: 0; width: 124dp; }
#pause { left: 0; top: 0; }
#speed-toggle { left: 0; top: 64dp; }
#age-open { left: 64dp; top: 0; }
#world-inspector-open { left: 64dp; top: 64dp; }
#speed-toggle img { width: 28dp; height: 28dp; margin: 0 auto; }
#speed-label { display: block; font-size: 12dp; line-height: 16dp; padding-right: 8dp; }
#speed-chevron { position: absolute; right: 8dp; bottom: 10dp; width: 8dp; height: 5dp; decorator: pixel-down(#fff6df); }
#toolbar-divider { position: absolute; left: 140dp; top: 4dp; width: 2dp; height: 116dp; background-color: #0d1117; }
#section-tools { left: 156dp; top: 0; right: 0; overflow-x: auto; overflow-y: hidden; }
.tool-page { position: relative; height: 124dp; }
.tool-page button { left: 0; top: 0; }
.future-tools span { position: absolute; left: 68dp; top: 20dp; right: 0; color: #dedbd4; }
.future-tools button img { height: 28dp; margin-top: 10dp; }
#speed-overlay { z-index: 9; background-color: transparent; }
#speed-panel { position: absolute; left: 12dp; bottom: 196dp; width: 320dp; padding: 12dp; box-sizing: border-box; }
#speed-panel label { margin: 0 4dp 8dp; }
#speed-options { display: flex; flex-wrap: wrap; }
#speed-options button { width: 68dp; min-height: 44dp; padding: 6dp 2dp; margin: 0 4dp 4dp 0; font-size: 24dp; line-height: 28dp; }
#age-panel { height: 432dp; }
#age-status { margin: 0 0 12dp; color: #b5b3ad; }
#age-choices, #age-modes { display: flex; flex-wrap: nowrap; }
#age-choices button, #age-modes button { width: 50%; flex-shrink: 0; }
#age-choices button { height: 104dp; padding: 8dp 6dp; }
#age-choices button img { display: block; width: 48dp; height: 48dp; margin: 0 auto 8dp; }
#age-choices button span { display: block; font-size: 12dp; line-height: 18dp; word-break: break-word; }
#age-modes button { min-height: 60dp; padding: 6dp; font-size: 24dp; }
#age-modes button img { width: 32dp; height: 32dp; margin-right: 8dp; }
#save-panel { decorator: physical-material(rock); position: absolute; padding: 16dp; box-sizing: border-box; overflow-y: auto; }
.save-entry { decorator: physical-material(rock #bbbbbbff); font-size: 24dp; line-height: 28dp; display: block; width: 100%; text-align: left; padding: 10dp 12dp; margin-bottom: 6dp; }
.save-entry.selected { decorator: physical-material(rock #eeeeeeff); }
.save-entry:hover, .save-entry:focus { decorator: physical-material(rock #ffffffff); }
.save-entry span { display: block; word-break: break-word; }
.save-entry .save-detail { font-size: 12dp; line-height: 18dp; color: #b5b3ad; margin-top: 4dp; }
/* Modal shields form real stacking contexts above the raised category tabs.
   An error can cover another open modal; informational layers never intercept
   its acknowledgement or any other interactive control. */
.overlay { display: none; position: absolute; z-index: 10; top: 0; left: 0; width: 100%; height: 100%; background-color: #01070ce0; }
#error-overlay { z-index: 20; }
.modal { position: absolute; box-sizing: border-box; padding: 16dp; overflow-y: auto; }
.modal h2 { margin-bottom: 12dp; }
.modal-heading { display: flex; align-items: center; margin-bottom: 12dp; }
.modal-heading h2 { flex-grow: 1; flex-shrink: 1; min-width: 0; margin-bottom: 0; }
.modal-heading button { flex-shrink: 0; padding: 6dp 8dp; }
.compact .modal-heading button span { display: none; }
#audio-volume { display: inline-block; width: 64dp; text-align: center; }
.audio-controls button { display: inline-block; width: 48dp; margin: 0 4dp 4dp 0; }
#error-panel, #settings-panel, #help-panel { decorator: physical-material(rock); }
#load-screen { decorator: physical-material(obsidian #ffffffff 0dp 0dp 0dp); }
#error-message { color: #dedbd4; }
#error-detail { color: #b5b3ad; font-size: 12dp; line-height: 18dp; }
#busy-indicator { position: absolute; z-index: 40; top: 12dp; right: 16dp; padding: 10dp 14dp; pointer-events: none; }
scrollbarvertical { width: 16dp; decorator: physical-material(rock #888888ff); }
scrollbarvertical sliderbar { decorator: physical-material(rock #eeeeeeff); }
scrollbarvertical slidertrack { decorator: physical-material(rock #686868ff); }
scrollbarvertical sliderarrowdec, scrollbarvertical sliderarrowinc { height: 16dp; }
scrollbarvertical sliderarrowdec { decorator: pixel-up(#ffffff); }
scrollbarvertical sliderarrowinc { decorator: pixel-down(#ffffff); }
#tool-tooltip { display: none; position: absolute; z-index: 30; box-sizing: border-box; max-width: 320dp; padding: 10dp 12dp; font-size: 12dp; line-height: 18dp; color: #dedbd4; pointer-events: none; decorator: physical-material(rock); }
body, #world-screen, #creation-screen, #scene-viewport { pointer-events: none; }
#main-menu, .topbar, .panel, .overlay, #bottom-bar, #world-status, #preview-caption, button, input, select { pointer-events: auto; }
.window-heading { display: flex; align-items: center; margin-bottom: 12dp; }
.window-heading h2 { flex-grow: 1; flex-shrink: 1; min-width: 0; font-size: 24dp; line-height: 36dp; margin: 0 8dp 0 0; }
.window-close { width: 60dp; height: 60dp; min-height: 60dp; padding: 6dp; flex-shrink: 0; decorator: physical-material(rock #bbbbbbff); }
.window-close:hover, .window-close:focus { decorator: physical-material(rock #ffffffff); }
.window-close img { margin: 0; }
/* Pressed stone wins over hover, selected and dedicated control declarations. */
button:active, button.selected:active, button.primary:active, .save-entry:active, .save-entry.selected:active, .window-close:active,
#world-status button:active, #create:active, #settings-close:active, #load-selected:active, #rename-commit:active { decorator: physical-material(rock #8c8c8cff); }
#bottom-bar button:active, #bottom-bar button.selected:active { decorator: physical-tab(rock #8c8c8cff); }
button:disabled, .save-entry:disabled, .window-close:disabled, #world-status button:disabled,
#create:disabled, #settings-close:disabled, #load-selected:disabled, #rename-commit:disabled { decorator: physical-material(rock #686868ff); color: #96948e; opacity: 0.6; }
