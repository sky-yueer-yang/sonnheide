/* Original compact sandbox interface: translucent dark frames, white
   category silhouettes and individually coloured tools. Disjoint frame bands
   preserve the true centre alpha; no copied game artwork. */
body, section, div, nav, h1, h2, h3, p, label { display: block; }
body { margin: 0; width: 100%; height: 100%; font-family: Sonn Arcade; font-size: 12dp; line-height: 18dp; font-weight: normal; color: #e8f2f4; }
h1, h2, h3, p { margin: 0; font-weight: normal; }
h1 { font-size: 36dp; line-height: 48dp; }
h2 { font-size: 24dp; line-height: 30dp; color: #ffd675; }
p { margin: 6dp 0; line-height: 18dp; word-break: break-word; }
label { margin: 8dp 0 4dp; line-height: 18dp; color: #e8f2f4; }
button, input, select, selectbox, option, scrollbarvertical sliderbar, scrollbarvertical slidertrack, scrollbarvertical sliderarrowdec, scrollbarvertical sliderarrowinc { border-width: 0; background-color: transparent; font-family: Sonn Arcade; }
button { display: inline-block; box-sizing: border-box; min-height: 32dp; max-width: 100%; padding: 4dp 10dp; margin: 0; font-size: 12dp; font-weight: normal; line-height: 20dp; color: #e8f2f4; tab-index: auto; cursor: pointer; vertical-align: middle; decorator: pixel-frame(#0a2836b0 #3b6276b8 #041a27c0 2dp 2dp); }
button:hover, button:focus { decorator: pixel-frame(#24566bd0 #6797accc #082a3be0 2dp 2dp); color: #ffffff; }
button.selected, button.primary { decorator: pixel-frame(#79463fcc #b18073cc #3e2729d8 2dp 2dp); color: #ffffff; }
button.selected:hover, button.selected:focus, button.primary:hover, button.primary:focus { decorator: pixel-frame(#955548dc #dba891dc #56342de0 2dp 2dp); color: #ffffff; }
button:active { decorator: pixel-frame(#082432d0 #041a27c0 #3b6276b8 2dp 2dp); }
button:disabled { decorator: pixel-frame(#132f3b90 #32505fa0 #061c2890 2dp 2dp); color: #718b93; cursor: arrow; opacity: 0.6; }
button img { display: inline-block; width: 32dp; height: 32dp; margin-right: 6dp; vertical-align: middle; }
input, select { display: block; width: 100%; box-sizing: border-box; min-height: 32dp; padding: 6dp 8dp; font-size: 12dp; line-height: 20dp; color: #ffffff; tab-index: auto; decorator: pixel-frame(#0a2836b0 #041a27c0 #3b6276b8 2dp 1dp); }
input:focus, select:focus { decorator: pixel-frame(#174354c8 #082a3be0 #6797accc 2dp 1dp); }
input:disabled, select:disabled { color: #718b93; }
selectvalue { padding: 0; }
selectarrow { width: 12dp; height: 12dp; decorator: pixel-down(#e8f2f4); }
selectbox { padding: 4dp; decorator: pixel-frame(#092735e8 #3b6276b8 #031a26d0 2dp 2dp); }
option { display: block; min-height: 28dp; padding: 4dp 8dp; font-size: 12dp; color: #e8f2f4; }
option:hover, option:checked { decorator: pixel(#79463fcc 1dp 0dp #00000000); }
.panel { decorator: pixel-frame(#082c3bcc #3b6276b8 #031a26d0 3dp 2dp); }
.setting-block { padding: 0 4dp 4dp; margin-top: 6dp; }
.setting-block label:first-child { margin-top: 4dp; }
#main-screen, #creation-screen, #world-screen, #load-screen { position: absolute; left: 0; top: 0; width: 100%; height: 100%; }
#main-menu { position: absolute; box-sizing: border-box; padding: 16dp; text-align: center; overflow-y: auto; }
#home-wordmark { position: relative; height: 52dp; margin: 0 0 12dp; }
#main-title, #title-back { position: absolute; top: 0; left: 0; width: 100%; margin: 0; font-size: 36dp; line-height: 48dp; font-effect: none; }
#title-back { top: 2dp; left: 2dp; color: #302a20; }
#main-title, #main-title .title-sun, #main-title .title-sea, #main-title .title-sky { color: #ffd675; }
#main-title span { display: inline; }
#main-actions { display: block; }
.menu-cell { width: 100%; box-sizing: border-box; padding: 2dp 0; }
#main-menu button { display: block; width: 100%; min-height: 40dp; padding: 4dp 12dp; text-align: left; font-size: 12dp; }
#main-menu button img { width: 32dp; height: 32dp; margin: 0 12dp 0 0; }
.topbar { position: absolute; left: 12dp; top: 8dp; right: 12dp; }
.topbar-row { display: flex; align-items: center; }
.topbar h2 { flex-grow: 1; flex-shrink: 1; min-width: 0; margin: 0 12dp; font-size: 24dp; }
.topbar button { flex-shrink: 0; }
.compact .topbar button span { display: none; }
.compact .topbar button img { margin-right: 0; }
.compact .topbar h2 { font-size: 12dp; }
.quiet { color: #c2d9e2; }
#creation-controls { z-index: 2; position: absolute; box-sizing: border-box; top: 56dp; padding: 12dp; overflow-y: auto; }
.mode-choices { display: flex; }
.mode-choices button { width: 50%; flex-shrink: 0; min-height: 44dp; padding: 4dp; font-size: 12dp; text-align: center; }
.mode-choices img { width: 32dp; height: 32dp; margin-right: 4dp; }
.input-pair { display: flex; width: 100%; }
.input-pair div { width: 50%; box-sizing: border-box; padding-right: 4dp; flex-shrink: 0; }
.input-pair div:last-child { padding-right: 0; padding-left: 4dp; }
.input-pair label { margin-top: 4dp; }
.size-presets { display: flex; flex-wrap: wrap; margin: 4dp 0; }
.size-presets button { width: 20%; flex-shrink: 0; min-height: 58dp; padding: 4dp 1dp; font-size: 12dp; line-height: 16dp; text-align: center; }
.size-presets button img { display: block; width: 32dp; height: 32dp; margin: 0 auto 2dp; }
.size-presets button span { display: block; }
.choices { margin: 4dp 0 6dp; }
.choices button { margin: 0 4dp 4dp 0; }
.actions { margin-top: 10dp; }
.actions button { margin: 0 4dp 4dp 0; }
.compact .actions button { display: block; width: 100%; margin: 0 0 4dp; }
.creation-actions { display: flex; }
.creation-actions button { display: inline-block; width: 50%; flex-shrink: 0; padding: 4dp; text-align: center; margin: 0; }
.creation-actions button img { display: block; margin: 0 auto 2dp; }
#create, #settings-close, #load-selected, #rename-commit { decorator: pixel-frame(#79463fcc #b18073cc #3e2729d8 2dp 2dp); color: #ffffff; }
#create:hover, #create:focus, #settings-close:hover, #settings-close:focus, #load-selected:hover, #load-selected:focus, #rename-commit:hover, #rename-commit:focus { decorator: pixel-frame(#955548dc #dba891dc #56342de0 2dp 2dp); }
#create:disabled, #rename-commit:disabled, #load-selected:disabled { decorator: pixel-frame(#132f3b90 #32505fa0 #061c2890 2dp 2dp); color: #718b93; }
#creation-population { font-size: 12dp; line-height: 18dp; padding: 0 4dp; }
#creation-scale { font-size: 12dp; line-height: 18dp; margin: 4dp 0; color: #c2d9e2; }
#scene-viewport { position: absolute; background-color: transparent; }
#earth-selection { display: none; position: absolute; box-sizing: border-box; border-width: 2dp; border-color: #ffd675; background-color: #f6b95630; pointer-events: none; }
.floating-actions { display: block; z-index: 3; position: absolute; bottom: 24dp; width: 264dp; padding: 4dp; box-sizing: border-box; decorator: pixel-frame(#082c3bcc #3b6276b8 #031a26d0 2dp 2dp); }
#map-button-row { display: flex; flex-wrap: nowrap; }
.floating-actions button { flex-shrink: 0; width: 40dp; height: 40dp; padding: 4dp; margin: 1dp; }
.floating-actions button img { width: 32dp; height: 32dp; margin: 0; }
#preview-caption { position: absolute; bottom: 12dp; margin: 0; font-size: 12dp; line-height: 18dp; padding: 6dp 10dp; decorator: pixel-frame(#082c3bcc #3b6276b8 #031a26d0 2dp 2dp); }
#world-status { position: absolute; top: 8dp; left: 8dp; max-width: 85%; box-sizing: border-box; padding: 4dp; decorator: pixel-frame(#082c3bcc #3b6276b8 #031a26d0 2dp 2dp); }
#world-status button { padding: 2dp 6dp; font-size: 12dp; }
#world-name { word-break: break-word; }
#world-time { display: inline-block; margin: 0 8dp; font-size: 12dp; color: #e8f2f4; }
#bottom-bar-frame { position: absolute; bottom: 0; left: 0; width: 100%; box-sizing: border-box; padding: 4dp 6dp 6dp; }
#bottom-bar { display: flex; flex-wrap: nowrap; width: 100%; box-sizing: border-box; padding: 0; text-align: center; }
#bottom-bar button { width: 48dp; height: 44dp; min-height: 44dp; flex-shrink: 0; padding: 6dp 8dp; margin: 0 2dp 0 0; }
#bottom-bar button span { display: none; }
#bottom-bar img { display: block; width: 32dp; height: 32dp; margin: 0; }
.toolbar { position: relative; width: 100%; box-sizing: border-box; padding: 6dp 2dp 0; overflow-y: auto; }
.toolbar button { width: 44dp; min-width: 44dp; height: 44dp; min-height: 44dp; padding: 6dp; margin: 0 2dp 2dp 0; font-size: 12dp; text-align: center; flex-shrink: 0; }
.toolbar button img { display: block; width: 32dp; height: 32dp; margin: 0; }
.toolbar button span { display: none; }
#observe-tools, #world-tools, .world-actions, #age-tools, .clock-row { display: flex; flex-wrap: wrap; align-items: center; }
#world-tools { width: 100%; }
.clock-row { margin-right: 10dp; }
.world-actions { margin-right: 10dp; }
#age-tools { margin-top: 2dp; }
#save-panel { position: absolute; padding: 14dp; box-sizing: border-box; overflow-y: auto; }
.save-entry { display: block; width: 100%; text-align: left; padding: 8dp 10dp; margin-bottom: 6dp; }
.save-entry span { display: block; word-break: break-word; }
.save-entry .save-detail { font-size: 12dp; line-height: 18dp; color: #c2d9e2; margin-top: 4dp; }
.overlay { display: none; position: absolute; top: 0; left: 0; width: 100%; height: 100%; decorator: pixel(#031b2790 0dp 0dp #00000000); }
.modal { position: absolute; box-sizing: border-box; padding: 16dp; overflow-y: auto; }
.modal h2 { margin-bottom: 10dp; }
.modal-heading { display: flex; align-items: center; margin-bottom: 10dp; }
.modal-heading h2 { flex-grow: 1; flex-shrink: 1; min-width: 0; margin-bottom: 0; }
.modal-heading button { flex-shrink: 0; padding: 4dp 8dp; }
.compact .modal-heading button span { display: none; }
#audio-volume { display: inline-block; width: 64dp; text-align: center; }
.audio-controls button { display: inline-block; width: 32dp; margin: 0 4dp 4dp 0; }
#error-panel { decorator: pixel-frame(#082c3bcc #895f59c0 #3e2729d8 3dp 2dp); }
#error-message { color: #ffb4b0; }
#error-detail { color: #c2d9e2; font-size: 12dp; line-height: 18dp; }
#busy-indicator { position: absolute; top: 8dp; right: 12dp; padding: 6dp 10dp; }
scrollbarvertical { width: 12dp; decorator: pixel(#06263290 0dp 0dp #00000000); }
scrollbarvertical sliderbar { decorator: pixel-frame(#3e6f84b0 #6c95a6b8 #062632c0 2dp 1dp); }
scrollbarvertical slidertrack { decorator: pixel(#06263290 0dp 0dp #00000000); }
scrollbarvertical sliderarrowdec, scrollbarvertical sliderarrowinc { height: 12dp; }
scrollbarvertical sliderarrowdec { decorator: pixel-up(#e8f2f4); }
scrollbarvertical sliderarrowinc { decorator: pixel-down(#e8f2f4); }
#tool-tooltip { display: none; position: absolute; box-sizing: border-box; max-width: 320dp; padding: 8dp 10dp; font-size: 12dp; line-height: 18dp; color: #ffffff; pointer-events: none; decorator: pixel-frame(#092735e8 #3b6276b8 #031a26d0 2dp 2dp); }
body, #world-screen, #creation-screen, #scene-viewport { pointer-events: none; }
#main-menu, .topbar, .panel, .overlay, #bottom-bar, #world-status, .floating-actions, #preview-caption, button, input, select { pointer-events: auto; }

.window-heading { display: flex; align-items: center; margin-bottom: 8dp; }
.window-heading h2 { flex-grow: 1; flex-shrink: 1; min-width: 0; font-size: 24dp; line-height: 30dp; margin: 0 6dp 0 0; }
.window-close { width: 40dp; height: 40dp; min-height: 40dp; padding: 4dp; flex-shrink: 0; decorator: pixel-frame(#79463fcc #b18073cc #3e2729d8 2dp 2dp); }
.window-close img { margin: 0; }

.clock-row button { line-height: 32dp; }

#bottom-bar-frame { decorator: pixel-frame(#062b39c8 #3b6276b8 #031a26d0 2dp 2dp); }

/* RmlUi 5 requires a normal block between nested flex formatting contexts. */
.tool-group { display: block; height: 48dp; flex-shrink: 0; }
.clock-group { width: 240dp; }
.save-group { width: 148dp; }
