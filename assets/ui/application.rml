<rml>
<head><title>SONNHEIDE</title><link type="text/rcss" href="application.rcss"/></head>
<body>
<section id="main-screen">
<div id="main-menu" class="panel arcade-home"><h1 id="main-title">SONNHEIDE</h1><nav id="main-actions">
<div class="menu-cell"><button id="new-world" class="primary"><span data-key="new">创建世界</span></button></div>
<div class="menu-cell"><button id="continue-world"><span data-key="continue">继续</span></button></div>
<div class="menu-cell"><button id="load"><span data-key="load">载入世界</span></button></div>
<div class="menu-cell"><button id="settings-main"><span data-key="settings">设置</span></button></div>
<div class="menu-cell full"><button id="exit"><span data-key="exit">退出</span></button></div>
</nav></div>
</section>
<section id="creation-screen">
<div class="topbar"><div class="topbar-row"><button id="cancel-create" class="quiet"><img src="../generated/ui/icons/back-96.png"/><span data-key="back">返回</span></button><h2 data-key="new">创建世界</h2><button id="creation-options" data-key="world-options">选项</button></div></div>
<div id="creation-controls" class="panel">
<div class="mode-choices"><button id="blank-mode"><img src="../generated/ui/icons/blank-96.png"/><span data-key="blank">空白世界</span></button><button id="earth-mode"><img src="../generated/ui/icons/earth-96.png"/><span data-key="earth">地球选区</span></button></div>
<div class="setting-block"><label for="creation-name" data-key="world-name">世界名称</label><input id="creation-name" type="text" maxlength="128"/></div>
<div id="blank-controls" class="setting-block"><label data-key="surface">初始地表</label><div class="choices"><button id="blank-soil" data-key="soil">平土</button><button id="blank-ocean" data-key="ocean">海洋</button></div></div>
<div class="setting-block"><label data-key="size">地图格数</label><div class="input-pair"><div><label for="creation-width" data-key="width">宽</label><input id="creation-width" type="text"/></div><div><label for="creation-height" data-key="height">高</label><input id="creation-height" type="text"/></div></div>
<label id="creation-theme-label" data-key="theme">地表主题</label><select id="creation-theme"><option value="snowfield" data-key="snowfield">雪原</option><option value="flower_meadow" selected="selected" data-key="flower_meadow">花甸</option><option value="maple_field" data-key="maple_field">枫原</option><option value="cherry_field" data-key="cherry_field">樱野</option><option value="wetland" data-key="wetland">湿地</option><option value="savanna" data-key="savanna">荒原</option><option value="sonnheide_sacred" data-key="sonnheide_sacred">圣原</option><option value="volcanic" data-key="volcanic">炎地</option></select></div>
<div id="earth-controls" class="setting-block"><label data-key="coordinates">选区经纬度</label><div class="input-pair"><div><label for="earth-west" data-key="west">西</label><input id="earth-west" type="text"/></div><div><label for="earth-east" data-key="east">东</label><input id="earth-east" type="text"/></div></div><div class="input-pair"><div><label for="earth-south" data-key="south">南</label><input id="earth-south" type="text"/></div><div><label for="earth-north" data-key="north">北</label><input id="earth-north" type="text"/></div></div><p id="earth-package"></p></div>
<p id="creation-population" data-key="initial-empty">开局没有人物或建筑。</p>
<div class="actions creation-actions"><button id="preview"><img src="../generated/ui/icons/camera-96.png"/><span data-key="preview">预览地表</span></button><button id="create"><img src="../generated/ui/icons/create-96.png"/><span data-key="create">创建世界</span></button></div>
</div>
<div id="scene-viewport"></div>
<div id="map-controls" class="floating-actions"><button id="map-out" data-key="zoom-out">缩小</button><button id="map-in" data-key="zoom-in">放大</button><button id="map-left" data-key="move-west">向西</button><button id="map-right" data-key="move-east">向东</button><button id="map-up" data-key="move-north">向北</button><button id="map-down" data-key="move-south">向南</button></div>
<p id="preview-caption" data-key="preview-camera">拖动旋转 · 滚轮缩放</p>
</section>
<section id="world-screen">
<div id="world-status"><button id="world-info"><img src="../generated/ui/icons/world-96.png"/><span id="world-name"></span></button><span id="world-time"></span></div>
<div id="section-tools" class="toolbar panel">
<div id="observe-tools"><button id="camera-home"><img src="../generated/ui/icons/camera-96.png"/><span data-key="camera-home">复位镜头</span></button><button id="camera-help"><img src="../generated/ui/icons/help-96.png"/><span data-key="camera-help">操作帮助</span></button></div>
<div id="world-tools"><div class="clock-row"><button id="pause"><img id="pause-icon" src="../generated/ui/icons/pause-96.png"/><span id="pause-label"></span></button><button id="speed-one">1×</button><button id="speed-four">4×</button><button id="speed-sixteen">16×</button><button id="speed-sixtyfour">64×</button></div><div class="world-actions"><button id="save"><img src="../generated/ui/icons/save-96.png"/><span data-key="save">保存</span></button><button id="world-load"><img src="../generated/ui/icons/load-96.png"/><span data-key="load">载入世界</span></button><button id="return-menu"><img src="../generated/ui/icons/back-96.png"/><span data-key="main-menu">主菜单</span></button></div></div>
<div id="age-tools"><button id="age-light" data-key="age-light">光明时代</button><button id="age-darkness" data-key="age-darkness">黑暗时代</button><button id="age-auto" data-key="age-auto">自动交替</button><button id="age-manual" data-key="age-manual">手动切换</button></div>
</div>
<div id="bottom-bar-frame"><nav id="bottom-bar">
<button id="tab-observe"><img src="../generated/ui/icons/camera-96.png"/><span data-key="tab-observe">观察</span></button>
<button id="tab-terrain"><img src="../generated/ui/icons/terrain-96.png"/><span data-key="tab-terrain">地形与生态</span></button>
<button id="tab-life"><img src="../generated/ui/icons/people-96.png"/><span data-key="tab-life">人物与动物</span></button>
<button id="tab-civilization"><img src="../generated/ui/icons/laws-96.png"/><span data-key="tab-civilization">文明制度</span></button>
<button id="tab-construction"><img src="../generated/ui/icons/buildings-96.png"/><span data-key="tab-construction">建设资源</span></button>
<button id="tab-economy"><img src="../generated/ui/icons/economy-96.png"/><span data-key="tab-economy">经济物品</span></button>
<button id="tab-world"><img src="../generated/ui/icons/world-96.png"/><span data-key="tab-world">世界</span></button>
<button id="tab-settings"><img src="../generated/ui/icons/settings-96.png"/><span data-key="tab-settings">设置</span></button>
</nav></div>
</section>
<section id="load-screen"><div class="topbar"><div class="topbar-row"><button id="back-load" class="quiet"><img src="../generated/ui/icons/back-96.png"/><span data-key="back">返回</span></button><h2 data-key="load">载入世界</h2></div></div><div id="save-panel" class="panel"><p id="no-saves" data-key="no-saves">暂无世界存档。</p><div id="save-list"></div><div class="actions"><button id="load-selected"><img src="../generated/ui/icons/load-96.png"/><span data-key="load-selected">载入所选世界</span></button></div></div></section>
<div id="settings-overlay" class="overlay"><div id="settings-panel" class="modal panel"><h2 data-key="settings">设置</h2><label data-key="language">界面语言</label><div class="choices"><button id="locale-zh">简体中文</button><button id="locale-en">English</button><button id="locale-de">Deutsch</button></div><label data-key="display">显示</label><div class="choices"><button id="fullscreen" data-key="fullscreen">全屏</button><button id="windowed" data-key="windowed">窗口</button></div><label data-key="motion">动态效果</label><div class="choices"><button id="motion-normal" data-key="motion-normal">完整动态</button><button id="motion-reduced" data-key="motion-reduced">减少动态</button></div><label for="audio-volume" data-key="volume">音量</label><div class="choices audio-controls"><button id="volume-down">-</button><input id="audio-volume" type="text"/><button id="volume-up">+</button><span>%</span></div><div class="actions"><button id="settings-close"><img src="../generated/ui/icons/check-96.png"/><span data-key="done">完成</span></button></div></div></div>
<div id="world-overlay" class="overlay"><div id="world-panel" class="modal panel"><div class="modal-heading"><h2 data-key="world">世界</h2><button id="world-close"><img src="../generated/ui/icons/close-96.png"/><span data-key="close">关闭</span></button></div><p id="world-facts"></p><label for="world-name-draft" data-key="world-name">世界名称</label><input id="world-name-draft" type="text" maxlength="128"/><p id="rename-consequences"></p><div class="actions"><button id="rename-preview" data-key="show-consequences">查看后果</button><button id="rename-commit" data-key="apply-name">提交名称</button><button id="rename-cancel" data-key="cancel-draft">放弃草案</button></div></div></div>
<div id="help-overlay" class="overlay"><div id="help-panel" class="modal panel"><h2 data-key="camera-help">操作帮助</h2><p data-key="camera-orbit"></p><p data-key="camera-pan"></p><p data-key="camera-keys"></p><div class="actions"><button id="help-close" data-key="close">关闭</button></div></div></div>
<div id="error-overlay" class="overlay"><div id="error-panel" class="modal panel"><h2 data-key="operation-failed">操作未完成</h2><p id="error-message"></p><button id="error-details" data-key="technical-details">技术详情</button><p id="error-detail"></p><div class="actions"><button id="error-dismiss" data-key="back">返回</button></div></div></div>
<div id="busy-indicator" class="panel"><span id="busy-label" data-key="working">正在处理</span></div>
</body>
</rml>
