<rml>
<head><title>SONNHEIDE</title><link type="text/rcss" href="application.rcss"/></head>
<body>
<section id="main-screen">
<div id="main-menu" class="arcade-home panel">
<div id="home-wordmark"><h1 id="main-title"><span class="title-sun">SONN</span><span class="title-sea">HEI</span><span class="title-sky">DE</span></h1></div>
<nav id="main-actions">
<div class="menu-cell"><button id="new-world" class="primary"><img src="../generated/ui/icons/create-96.png"/><span data-key="new">创建世界</span></button></div>
<div class="menu-cell"><button id="continue-world"><img src="../generated/ui/icons/play-96.png"/><span data-key="continue">继续</span></button></div>
<div class="menu-cell"><button id="load"><img src="../generated/ui/icons/load-96.png"/><span data-key="load">载入世界</span></button></div>
<div class="menu-cell"><button id="settings-main"><img src="../generated/ui/icons/settings-96.png"/><span data-key="settings">设置</span></button></div>
<div class="menu-cell"><button id="exit"><img src="../generated/ui/icons/exit-96.png"/><span data-key="exit">退出</span></button></div>
</nav></div>
</section>
<section id="creation-screen">
<div id="creation-topbar" class="topbar"><div class="topbar-row"><button id="cancel-create" class="quiet"><img src="../generated/ui/icons/back-96.png"/><span data-key="back">返回</span></button><h2 data-key="new">创建世界</h2><button id="creation-options" data-key="world-options">选项</button></div></div>
<div id="creation-controls" class="panel"><div id="creation-heading" class="window-heading"><h2 data-key="new">创建世界</h2><button id="creation-close" class="window-close" data-tooltip-key="close"><img src="../generated/ui/icons/close-96.png"/></button></div>
<div id="creation-form">
<div class="setting-block"><label for="creation-name" data-key="world-name">世界名称</label><input id="creation-name" type="text" maxlength="128"/></div>
<div id="blank-controls" class="setting-block"><label data-key="surface">初始地表</label><div class="choices"><button id="blank-soil" data-key="soil">平土</button><button id="blank-ocean" data-key="ocean">海洋</button></div></div>
<div class="setting-block"><label data-key="size">世界尺寸</label><div id="size-presets" class="size-presets"><button id="size-256" data-tooltip-key="size-256-full"><img src="../generated/ui/icons/blank-96.png"/><span>512 m</span></button><button id="size-512" data-tooltip-key="size-512-full"><img src="../generated/ui/icons/blank-96.png"/><span>1.024 km</span></button><button id="size-1024" data-tooltip-key="size-1024-full"><img src="../generated/ui/icons/blank-96.png"/><span>2.048 km</span></button><button id="size-2048" data-tooltip-key="size-2048-full"><img src="../generated/ui/icons/blank-96.png"/><span>4.096 km</span></button><button id="size-4096" data-tooltip-key="size-4096-full"><img src="../generated/ui/icons/blank-96.png"/><span>8.192 km</span></button></div><div class="input-pair"><div><label for="creation-width" data-key="width">宽</label><input id="creation-width" type="text"/></div><div><label for="creation-height" data-key="height">高</label><input id="creation-height" type="text"/></div></div>
<p id="creation-scale" class="quiet"></p><label id="creation-theme-label" data-key="theme">地表主题</label><select id="creation-theme"><option value="snowfield" data-key="snowfield">雪原</option><option value="flower_meadow" selected="selected" data-key="flower_meadow">花甸</option><option value="maple_field" data-key="maple_field">枫原</option><option value="cherry_field" data-key="cherry_field">樱野</option><option value="wetland" data-key="wetland">湿地</option><option value="savanna" data-key="savanna">荒原</option><option value="sonnheide_sacred" data-key="sonnheide_sacred">圣原</option><option value="volcanic" data-key="volcanic">炎地</option></select></div>
<p id="creation-population" data-key="initial-empty">开局没有人物或建筑。</p>
</div>
<div class="actions creation-actions"><button id="preview"><img src="../generated/ui/icons/camera-96.png"/><span data-key="preview">预览地表</span></button><button id="create"><img src="../generated/ui/icons/create-96.png"/><span data-key="create">创建世界</span></button></div>
</div>
<div id="scene-viewport"></div>
<p id="preview-caption" data-key="preview-camera">拖动旋转 · 滚轮缩放</p>
</section>
<section id="world-screen">
<div id="world-status"><button id="world-info"><img src="../generated/ui/icons/world-96.png"/><span id="world-name"></span></button><span id="world-time"></span></div>
<div id="bottom-dock"><div id="section-tabs"><nav id="bottom-bar">
<button id="tab-observe" data-tooltip-key="tab-observe-full"><img src="../generated/ui/icons/tab-camera-96.png"/></button>
<button id="tab-terrain" data-tooltip-key="tab-terrain-full"><img src="../generated/ui/icons/tab-terrain-96.png"/></button>
<button id="tab-life" data-tooltip-key="tab-life-full"><img src="../generated/ui/icons/tab-people-96.png"/></button>
<button id="tab-civilization" data-tooltip-key="tab-civilization-full"><img src="../generated/ui/icons/tab-laws-96.png"/></button>
<button id="tab-construction" data-tooltip-key="tab-construction-full"><img src="../generated/ui/icons/tab-buildings-96.png"/></button>
<button id="tab-economy" data-tooltip-key="tab-economy-full"><img src="../generated/ui/icons/tab-economy-96.png"/></button>
<button id="tab-world" data-tooltip-key="tab-world-full"><img src="../generated/ui/icons/tab-world-96.png"/></button>
<button id="tab-settings" data-tooltip-key="tab-settings-full"><img src="../generated/ui/icons/tab-settings-96.png"/></button>
</nav></div><div id="bottom-bar-frame" class="panel"><div id="toolbar-content">
<div id="persistent-tools" class="toolbar"><button id="pause" data-tooltip-key="pause"><img id="pause-icon" src="../generated/ui/icons/pause-96.png"/></button><button id="speed-toggle" data-tooltip-key="speed-title"><img src="../generated/ui/icons/toolbar-speed-96.png"/><span id="speed-label">1&#215;</span><div id="speed-chevron"></div></button><button id="age-open" data-tooltip-key="age-switch"><img src="../generated/ui/icons/toolbar-age-96.png"/></button><button id="world-inspector-open" data-tooltip-key="world"><img src="../generated/ui/icons/world-96.png"/></button></div>
<div id="toolbar-divider"></div>
<div id="section-tools" class="toolbar">
<div id="observe-tools" class="tool-page"><button id="camera-home" data-tool-slot="0" data-tooltip-key="camera-home"><img src="../generated/ui/icons/camera-96.png"/></button><button id="camera-help" data-tool-slot="1" data-tooltip-key="camera-help"><img src="../generated/ui/icons/help-96.png"/></button></div>
<div id="terrain-tools" class="tool-page future-tools"><button id="terrain-pending" data-tool-slot="0" disabled="disabled" data-tooltip-key="tab-terrain-full"><img src="../generated/ui/icons/tab-terrain-96.png"/></button><span data-key="not-available">Unavailable</span></div>
<div id="life-tools" class="tool-page future-tools"><button id="life-pending" data-tool-slot="0" disabled="disabled" data-tooltip-key="tab-life-full"><img src="../generated/ui/icons/tab-people-96.png"/></button><span data-key="not-available">Unavailable</span></div>
<div id="civilization-tools" class="tool-page future-tools"><button id="civilization-pending" data-tool-slot="0" disabled="disabled" data-tooltip-key="tab-civilization-full"><img src="../generated/ui/icons/tab-laws-96.png"/></button><span data-key="not-available">Unavailable</span></div>
<div id="construction-tools" class="tool-page future-tools"><button id="construction-pending" data-tool-slot="0" disabled="disabled" data-tooltip-key="tab-construction-full"><img src="../generated/ui/icons/tab-buildings-96.png"/></button><span data-key="not-available">Unavailable</span></div>
<div id="economy-tools" class="tool-page future-tools"><button id="economy-pending" data-tool-slot="0" disabled="disabled" data-tooltip-key="tab-economy-full"><img src="../generated/ui/icons/tab-economy-96.png"/></button><span data-key="not-available">Unavailable</span></div>
<div id="world-tools" class="tool-page"><button id="save" data-tool-slot="0" data-tooltip-key="save"><img src="../generated/ui/icons/save-96.png"/></button><button id="world-load" data-tool-slot="1" data-tooltip-key="load"><img src="../generated/ui/icons/load-96.png"/></button><button id="return-menu" data-tool-slot="2" data-tooltip-key="main-menu"><img src="../generated/ui/icons/back-96.png"/></button></div>
<div id="settings-tools" class="tool-page"><button id="settings-open" data-tool-slot="0" data-tooltip-key="settings"><img src="../generated/ui/icons/settings-96.png"/></button></div>
</div></div></div></div>
</section>
<section id="load-screen"><div class="topbar"><div class="topbar-row"><button id="back-load" class="quiet"><img src="../generated/ui/icons/back-96.png"/><span data-key="back">返回</span></button><h2 data-key="load">载入世界</h2></div></div><div id="save-panel" class="panel"><p id="no-saves" data-key="no-saves">暂无世界存档。</p><div id="save-list"></div><div class="actions"><button id="load-selected"><img src="../generated/ui/icons/load-96.png"/><span data-key="load-selected">载入所选世界</span></button></div></div></section>
<div id="speed-overlay" class="overlay"><div id="speed-panel" class="panel"><label data-key="speed-title">Speed</label><div id="speed-options"><button id="speed-half">0.5&#215;</button><button id="speed-one">1&#215;</button><button id="speed-one-half">1.5&#215;</button><button id="speed-two">2&#215;</button><button id="speed-three">3&#215;</button><button id="speed-five">5&#215;</button><button id="speed-ten">10&#215;</button></div></div></div>
<div id="age-overlay" class="overlay"><div id="age-panel" class="modal panel"><div class="window-heading"><h2 data-key="age-switch">Ages</h2><button id="age-dismiss" class="window-close" data-tooltip-key="close"><img src="../generated/ui/icons/close-96.png"/></button></div><p id="age-status"></p><div id="age-choices"><button id="age-light"><img src="../generated/ui/icons/sun-96.png"/><span data-key="age-light">Age of Light</span></button><button id="age-darkness"><img src="../generated/ui/icons/moon-96.png"/><span data-key="age-darkness">Age of Darkness</span></button></div><label data-key="age-mode">Alternation</label><div id="age-modes"><button id="age-manual"><img src="../generated/ui/icons/hand-96.png"/><span data-key="tool-age-manual">Manual</span></button><button id="age-auto"><img src="../generated/ui/icons/cycle-96.png"/><span data-key="tool-age-auto">Auto</span></button></div><div class="actions"><button id="age-close"><img src="../generated/ui/icons/check-96.png"/><span data-key="done">Done</span></button></div></div></div>
<div id="settings-overlay" class="overlay"><div id="settings-panel" class="modal panel"><div class="window-heading"><h2 data-key="settings">设置</h2><button id="settings-dismiss" class="window-close" data-tooltip-key="close"><img src="../generated/ui/icons/close-96.png"/></button></div><label data-key="language">界面语言</label><div class="choices"><button id="locale-zh">简体中文</button><button id="locale-en">English</button><button id="locale-de">Deutsch</button></div><label data-key="display">显示</label><div class="choices"><button id="fullscreen" data-key="fullscreen">全屏</button><button id="windowed" data-key="windowed">窗口</button></div><label data-key="motion">动态效果</label><div class="choices"><button id="motion-normal" data-key="motion-normal">完整动态</button><button id="motion-reduced" data-key="motion-reduced">减少动态</button></div><label for="audio-volume" data-key="volume">音量</label><div class="choices audio-controls"><button id="volume-down">-</button><input id="audio-volume" type="text"/><button id="volume-up">+</button><span>%</span></div><div class="actions"><button id="settings-close"><img src="../generated/ui/icons/check-96.png"/><span data-key="done">完成</span></button></div></div></div>
<div id="world-overlay" class="overlay"><div id="world-panel" class="modal panel"><div class="modal-heading"><h2 data-key="world">世界</h2><button id="world-close"><img src="../generated/ui/icons/close-96.png"/><span data-key="close">关闭</span></button></div><p id="world-facts"></p><label for="world-name-draft" data-key="world-name">世界名称</label><input id="world-name-draft" type="text" maxlength="128"/><p id="rename-consequences"></p><div class="actions"><button id="rename-preview" data-key="show-consequences">查看后果</button><button id="rename-commit" data-key="apply-name">提交名称</button><button id="rename-cancel" data-key="cancel-draft">放弃草案</button></div></div></div>
<div id="help-overlay" class="overlay"><div id="help-panel" class="modal panel"><div class="window-heading"><h2 data-key="camera-help">操作帮助</h2><button id="help-dismiss" class="window-close" data-tooltip-key="close"><img src="../generated/ui/icons/close-96.png"/></button></div><p data-key="camera-orbit"></p><p data-key="camera-pan"></p><p data-key="camera-keys"></p><div class="actions"><button id="help-close" data-key="close">关闭</button></div></div></div>
<div id="error-overlay" class="overlay"><div id="error-panel" class="modal panel"><h2 class="danger-heading" data-key="operation-failed">操作未完成</h2><p id="error-message"></p><button id="error-details" data-key="technical-details">技术详情</button><p id="error-detail"></p><div class="actions"><button id="error-dismiss" data-key="back">返回</button></div></div></div>
<div id="tool-tooltip"></div>
<div id="busy-indicator" class="panel"><span id="busy-label" data-key="working">正在处理</span></div>
</body>
</rml>
