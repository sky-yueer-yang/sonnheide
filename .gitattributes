* text=auto
*.md text eol=lf
*.cpp text eol=lf
*.hpp text eol=lf
*.py text eol=lf
*.yml text eol=lf
*.txt text eol=lf
*.json text eol=lf
*.gltf text eol=lf
*.html text eol=lf
*.xml text eol=lf
third_party/abyssal-ocean/LICENSE text eol=lf
*.blend filter=lfs diff=lfs merge=lfs -text
*.glb filter=lfs diff=lfs merge=lfs -text
*.bin filter=lfs diff=lfs merge=lfs -text
*.png filter=lfs diff=lfs merge=lfs -text
*.jpg filter=lfs diff=lfs merge=lfs -text
*.exr filter=lfs diff=lfs merge=lfs -text
*.ktx2 filter=lfs diff=lfs merge=lfs -text
*.wav filter=lfs diff=lfs merge=lfs -text
*.ogg filter=lfs diff=lfs merge=lfs -text
*.pack filter=lfs diff=lfs merge=lfs -text
*.zip filter=lfs diff=lfs merge=lfs -text
assets/source/third_party/makehuman/** -text
# Five small, pinned menu paintings travel with offline previews (3.2 MB total).
# Larger future textures and authored art continue to use the global LFS rules.
assets/source/ui/paintings/*.jpg -filter -diff -merge -text
# The 199 KB supplied company mark and 125 KB font are bounded offline UI sources.
assets/source/ui/branding/*.png -filter -diff -merge -text
assets/source/ui/fonts/*.ttf -text
assets/source/ui/fonts/*.pb text eol=lf

*.svg text eol=lf

# Keep UI/build source line endings reproducible across Windows checkouts.
*.js text eol=lf
*.css text eol=lf
*.rcss text eol=lf
*.rml text eol=lf
*.cmake text eol=lf
*.mm text eol=lf
*.sh text eol=lf
*.sc text eol=lf
*.def text eol=lf

# Original upstream notices are byte-locked; never convert their newlines.
third_party/native/** -text

# Preserve the exact MIT upstream Hex-Tiling headers and license bytes.
third_party/hextile/** -text
third_party/hextile/UPSTREAM.json text eol=lf

# Preserve byte-locked original GSHHG license and documentation (including CRLF).
data/geo/sources/gshhg/** -text

# Bounded original UI icons ship in Git; their author recipe and hashes are tracked.
assets/generated/ui/icons/*.png -filter -diff -merge -text
*.tsv text eol=lf
*.inc text eol=lf
third_party/unicode/LICENSE.txt -text
assets/source/ui/fonts/fusion-pixel/*.gz -filter -diff -merge -text
assets/source/ui/fonts/fusion-pixel/OFL.txt -text
assets/source/ui/fonts/fusion-pixel/LICENSES/** -text
# Three bounded native GPU proof images; never a local save or generated cache.
docs/evidence/s00-s01-arcade/*.png -filter -diff -merge -text
*.command text eol=lf
# Bounded actual native visual proof images.
docs/evidence/arcade-v2/*.png -filter -diff -merge -text
# Bounded lossless captures of the actual large-world/translucent native batch.
docs/evidence/large-world-micro/*.png -filter -diff -merge -text

docs/evidence/heavy-arcade/*.png -filter -diff -merge -text
# Raw tool logs preserve upstream whitespace as recorded evidence.
docs/evidence/heavy-arcade/*.log -text -whitespace
