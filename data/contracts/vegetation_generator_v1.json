    "candidate_source": "world_bucket_sampler_epoch_candidateOrdinal",
    "max_candidate_attempts_per_acceptance_goal": 24,
    "min_distance_rule": "distance_squared >= (mature_structure_radius_i+mature_structure_radius_j+margin)^2",
    "neighbor_halo": "frozen_max_radius_or_hierarchical_index",
    "dead_tree_excluded_from_wild_recovery": true,
    "on_failed_sampling": "stop_do_not_relax_spacing",
