{
  "schema_version": 1,
  "contract_id": "sonnheide_vegetation_generator_v1",
  "design_version": "0.9",
  "planned_only": true,
  "production_implemented": false,
  "source": "docs/architecture/VEGETATION_GENERATOR_AND_DENSITY.md",
  "decision": "docs/decisions/0015-settlements-natural-actions-and-god-control.md",
  "interfaces": {
    "surface_ecology": "data/contracts/surface_ecology.json",
    "terrain_access": "data/contracts/terrain_access_v1.json",
    "geography_mutation": "data/contracts/god_control_v1.json",
    "settlement": "data/contracts/settlement_lifecycle_v1.json"
  },
  "tool": {
    "id": "vegetation_generator",
    "section": "terrain_ecology",
    "labels": {
      "zh-CN": "植被生成",
      "en": "Vegetation generator",
      "de": "Vegetationsgenerator"
    },
    "modes": [
      "TREES_AND_DECOR",
      "TREES_ONLY",
      "DECOR_ONLY"
    ],
    "default": "TREES_AND_DECOR",
    "global_entry": "bottom_toolbar",
    "borders_outlines_rings": false,
    "requires_probability_or_seed_entry": false,
    "hold_increases_density": true
  },
  "commands": [
    {
      "id": "CommitVegetationDoseBatch",
      "command_class": "world_transaction",
      "single_writer": true,
      "idempotent_dispatch": true,
      "preview_revalidation": true,
      "arbitrary_json_overwrite": false,
      "creates_Actors": false,
      "target_page": "plant"
    },
    {
      "id": "EndVegetationStroke",
      "command_class": "ui_only",
      "single_writer": false,
      "mutates_world": false,
      "arbitrary_json_overwrite": false
    }
  ],
  "authority": {
    "player_requires": "explicit_player_ecology_edit_capability",
    "GodVegetationSource_creates_bounded_Plant_structural_biomass": true,
    "godterrain_creates_inventory": false,
    "direct_ItemBatch_money_animal_generation": false,
    "initial_fruit_nectar_pollen_forage": 0,
    "generated_timber_harvest": "actual_remaining_biomass_real_rights_access_labor_reservation_and_transport",
    "existing_tree_or_fruit_refill": false,
    "generated_source_event_preserved": true,
    "wild_rule_key": "wild_vegetation_recovery",
    "wild_rule_blocks_explicit_player_generator": false
  },
  "source_modes": {
    "GOD_VEGETATION": {
      "default_living_stage": "young",
      "initial_woody_biomass": "frozen_species_bounded_source_definition",
      "dead_tree": "bounded_finite_deadwood_source_no_growth",
      "grants_warehouse_goods": false
    },
    "CIVIC_PLANTING": {
      "real_inputs": [
        "propagule",
        "labor",
        "path",
        "rights"
      ],
      "duplicates_transferred_biomass": false
    },
    "WILD_RECRUITMENT": {
      "rule": "wild_vegetation_recovery",
      "budget": "saved_finite_ecological_candidate_budget",
      "default_stage": "young",
      "no_wall_time_refill": true
    }
  },
  "input_clock": {
    "domain": "EditorInputClock_not_SimTick_not_RenderFrame",
    "slot_ms": 25,
    "commit_batch_ms": 100,
    "max_unverified_gap_ms": 125,
    "kernel": "(1-u*u)^2_for_0<=u<1_else_0",
    "dose": "sum_fixedpoint_dt*K*strength",
    "space_interpolation": "canonical_world_arc_segments_with_conserved_time_weights",
    "pause_world": "explicit_editing_allowed_natural_growth_stops",
    "terminate_on": [
      "button_up",
      "focus_loss",
      "hidden_window",
      "menu_open",
      "world_or_session_change",
      "load"
    ],
    "late_wall_time_catch_up": false,
    "receipt_key": [
      "WorldId",
      "SessionGeneration",
      "StrokeId",
      "slotIndex",
      "batchIndex"
    ]
  },
  "density": {
    "law": "increment_delta_fraction=(1-actual_realized_fraction)*(1-exp(-new_dose/tau));no_historical_target_deficit_replay",
    "trees_tau_editor_seconds": 6,
    "decor_tau_editor_seconds": 3,
    "local_bucket_m": 8,
    "rolling_window_m": 32,
    "max_mature_crown_projection_fraction": 0.48,
    "max_decor_visual_ground_cover_fraction": 0.38,
    "min_structure_margin_mm": 400,
    "counts_existing_all_sources": true,
    "mixed_profile_quota": "sum(count_i/cap_i)<=1_per_actual_habitat_area",
    "uses_exact_dry_suitable_area": true,
    "crown_window_intersection": "exact_rational_clip_of_conservative_integer_halfplane_octagon_including_outside_centers",
    "older_overdense_trees": "not_deleted_only_block_new_generation",
    "max_new_trees_per_batch": 8,
    "backlog_when_blocked": 0,
    "failed_dose": "consumed_rejected_no_future_quantity_credit",
    "reset_tree_dose_on": [
      "geography_wipe",
      "explicit_tree_clear",
      "real_completed_felling"
    ],
    "reset_scope": "actual_removed_root_envelope_local_epoch_no_existing_tree_or_stock_reset",
    "law_implementation": "frozen_fixedpoint_exp_lookup",
    "continuous_envelope_only": "1-exp(-cumulative_unblocked_dose/tau)_not_exact_discrete_population",
    "fractional_credit": "strictly_less_than_one_tree_only_current_feasible_space_reset_on_reject_cap_clear_wipe",
    "window_grid": {
      "origin": "frozen_World_grid_origin",
      "stride_mm": 8000,
      "side_mm": 32000,
      "tests_all_continuous_sliding_windows": false,
      "query": "all_fixed_windows_intersecting_candidate_mature_crown_envelope"
    },
    "crown_octagon": {
      "axis_bounds": "abs(dx),abs(dy)<=radius_mm",
      "diagonal_bounds": "abs(dx+dy),abs(dx-dy)<=ceil(radius_mm*141422/100000)",
      "rational_area_rounding": "upward",
      "platform_float_trig_used_for_cap": false
    }
  },
  "profiles": [
    {
      "surface_profile": "snowfield",
      "sample_max_stems_per_1024_suitable_m2": 40,
